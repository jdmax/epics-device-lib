<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated template; edit freely in Phoebus Display Builder. -->
<display version="2.0.0">
  <name>IOC control row</name>
  <macros>
    <P>TGT:EXAMPLE</P>
    <IOC>ioc_name</IOC>
    <LABEL>$(IOC)</LABEL>
  </macros>
  <width>410</width>
  <height>24</height>
  <widget type="group" version="2.0.0">
    <name>$(IOC)</name>
    <x>0</x>
    <y>0</y>
    <width>410</width>
    <height>24</height>
    <style>3</style>
    <widget type="label" version="2.0.0">
      <name>Label</name>
      <x>0</x>
      <y>0</y>
      <width>200</width>
      <height>20</height>
      <text>$(LABEL)</text>
      <horizontal_alignment>0</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget type="combo" version="2.0.0">
      <name>Combo Box</name>
      <x>205</x>
      <y>0</y>
      <width>100</width>
      <height>20</height>
      <pv_name>$(P):MAN:$(IOC)_control</pv_name>
      <items_from_pv>true</items_from_pv>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>Heartbeat</name>
      <x>315</x>
      <y>0</y>
      <width>90</width>
      <height>22</height>
      <pv_name>$(P):MAN:$(IOC)_hb</pv_name>
      <format>1</format>
      <precision>1</precision>
      <show_units>false</show_units>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
      <tooltip>Seconds since last update; red above 10 s while set to Run</tooltip>
      <rules>
        <rule name="Heartbeat stale" prop_id="background_color" out_exp="false">
          <exp bool_exp="pv1 != 1">
            <value>
              <color name="Read_Background" red="240" green="240" blue="240"/>
            </value>
          </exp>
          <exp bool_exp="pv0 &gt; 10">
            <value>
              <color name="MAJOR" red="255" green="0" blue="0"/>
            </value>
          </exp>
          <exp bool_exp="pv0 &lt;= 10">
            <value>
              <color name="OK" red="0" green="255" blue="0"/>
            </value>
          </exp>
          <pv_name>$(P):MAN:$(IOC)_hb</pv_name>
          <pv_name>$(P):MAN:$(IOC)_control</pv_name>
        </rule>
      </rules>
      <transparent>false</transparent>
    </widget>
  </widget>
</display>
